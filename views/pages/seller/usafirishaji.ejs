<%- include('../../partials/dash-top-seller') %>

<h1>Usafirishaji</h1>
<p style="margin-bottom:24px;">Usafirishaji wa <strong>Public</strong> na <strong>Protected</strong> sasa unaanzishwa na mnunuzi mwenyewe (aliyesajiliwa) kutoka kwenye ukurasa wa bidhaa yako, ili muunganishwe na kukubaliana bei ya usafirishaji pamoja na msafirishaji. Hapa chini unaweza kurekodi usafirishaji wa <strong>Private</strong> tu (unaopangwa nje ya jukwaa).</p>

<div class="card" style="padding:24px; margin-bottom:32px; max-width:640px;">
  <h3 style="font-size:16px; margin-bottom:14px;">Rekodi Usafirishaji wa Private</h3>
  <form action="/duka-langu/usafirishaji/ongeza" method="POST">
    <div class="field-row">
      <div class="field">
        <label>Jina la Mnunuzi</label>
        <input type="text" name="buyer_name">
      </div>
      <div class="field">
        <label>Simu ya Mnunuzi</label>
        <input type="tel" name="buyer_simu">
      </div>
    </div>
    <div class="field-row">
      <div class="field">
        <label>Eneo la Kuchukua</label>
        <input type="text" name="eneo_kuchukua" value="<%= currentSeller.location || '' %>">
      </div>
      <div class="field">
        <label>Eneo la Kupeleka</label>
        <input type="text" name="eneo_kupeleka">
      </div>
    </div>
    <button type="submit" class="btn btn-accent">Rekodi Usafirishaji</button>
  </form>
</div>

<h3 style="font-size:17px; margin-bottom:14px;">Historia ya Usafirishaji (Zote — Private, Protected, Public)</h3>
<% if (!maombi.length) { %>
  <div class="empty"><div class="mark">&#128666;</div>Bado hakuna rekodi za usafirishaji.</div>
<% } else { %>
<div class="table-wrap">
  <table>
    <thead><tr><th>Tarehe</th><th>Aina</th><th>Mnunuzi</th><th>Kutoka &rarr; Kwenda</th><th>Bei ya Usafirishaji</th><th>Hali</th><th></th></tr></thead>
    <tbody>
      <% maombi.forEach(m => { %>
      <tr>
        <td><%= timeAgo(m.created_at) %></td>
        <td style="text-transform:capitalize;"><%= m.aina %></td>
        <td><%= m.buyer_name || '—' %></td>
        <td><%= m.eneo_kuchukua || '—' %> &rarr; <%= m.eneo_kupeleka || '—' %></td>
        <td>
          <% if (m.gharama_iliyopendekezwa) { %>
            <%= fmtMoney(m.gharama_iliyopendekezwa) %>
            <% if (m.gharama_imekubaliwa) { %><span class="badge badge-approved" style="margin-left:4px;">Imekubaliwa</span><% } %>
          <% } else { %>—<% } %>
        </td>
        <td><span class="badge <%= m.status === 'imewasili' ? 'badge-approved' : 'badge-pending' %>"><%= m.status %></span></td>
        <td>
          <% if (m.aina !== 'private') { %><a href="/usafirishaji/<%= m.id %>" class="btn btn-ghost btn-sm">Mazungumzo ya Bei</a><% } %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<%- include('../../partials/dash-bottom') %>
