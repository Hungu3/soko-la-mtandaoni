<!DOCTYPE html>
<html lang="sw">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Fungua Duka — Soko la Mtandaoni</title>
<link rel="icon" type="image/png" href="/public/img/icon-32.png">
<link rel="stylesheet" href="/public/css/style.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
</head>
<body>
<div class="auth-shell">
  <div class="auth-box" style="max-width:560px;">
    <a href="/" class="brand"><img src="/public/img/logo.png" alt=""><span>Soko la Mtandaoni</span></a>
    <h1 style="text-align:center; font-size:24px; margin-bottom:6px;">Fungua Duka Lako</h1>
    <p style="text-align:center; margin:0 auto 24px;">Anza bure — bidhaa 20, picha 2 kwa bidhaa. Boresha unapokua.</p>

    <% if (flashError) { %><div class="alert alert-error"><%= flashError %></div><% } %>
    <% if (flashSuccess) { %><div class="alert alert-success"><%= flashSuccess %></div><% } %>

    <div class="form-card">
      <form action="/jisajili/muuzaji" method="POST" enctype="multipart/form-data">
        <div class="field <%= missingFields.includes('latitude') ? 'field-invalid' : '' %>">
          <label>Jina la Duka *</label>
          <input type="text" name="jina_duka" required value="<%= formData.jina_duka || '' %>" class="<%= missingFields.includes('jina_duka') ? 'input-invalid' : '' %>" placeholder="Mfano: Duka la Mama Amina">
        </div>
        <div class="field-row">
          <div class="field">
            <label>Aina ya Bidhaa *</label>
            <input type="text" name="aina_bidhaa" required value="<%= formData.aina_bidhaa || '' %>" class="<%= missingFields.includes('aina_bidhaa') ? 'input-invalid' : '' %>" placeholder="Mazao, Nguo, Vifaa, n.k.">
          </div>
          <div class="field">
            <label>Namba ya Simu *</label>
            <input type="tel" name="simu" required value="<%= formData.simu || '' %>" class="<%= missingFields.includes('simu') ? 'input-invalid' : '' %>" placeholder="07XXXXXXXX">
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label>Barua Pepe *</label>
            <input type="email" name="email" required value="<%= formData.email || '' %>" class="<%= missingFields.includes('email') ? 'input-invalid' : '' %>">
          </div>
          <div class="field">
            <label>Location (Mtaa/Mji) *</label>
            <input type="text" name="location" required value="<%= formData.location || '' %>" data-google-map-input class="<%= missingFields.includes('location') ? 'input-invalid' : '' %>" placeholder="Mfano: Kariakoo, Dar es Salaam">
            <a class="btn btn-outline btn-sm google-map-link" data-google-map-link target="_blank" rel="noopener noreferrer" <%= formData.location ? '' : 'hidden' %>>Fungua eneo kwenye Google Maps</a>
          </div>
        </div>
        <div class="field">
          <label>Weka Eneo la Duka kwenye Ramani *</label>
          <div id="rampaDuka" class="map-picker"></div>
          <div class="map-hint">Bonyeza mahali kwenye ramani panapoonyesha eneo la duka lako. Ramani itajaribu kutumia eneo lako la sasa kama utaruhusu.</div>
          <input type="hidden" name="latitude" id="latitude" value="<%= formData.latitude || '' %>">
          <input type="hidden" name="longitude" id="longitude" value="<%= formData.longitude || '' %>">
        </div>
        <div class="field">
          <label>Maelezo Mafupi ya Duka *</label>
          <textarea name="maelezo_duka" required class="<%= missingFields.includes('maelezo_duka') ? 'input-invalid' : '' %>" placeholder="Tueleze kidogo kuhusu biashara yako..."><%= formData.maelezo_duka || '' %></textarea>
        </div>
        <div class="field">
          <label>Siku na Muda wa Kufanya Biashara *</label>
          <input type="text" name="siku_kufunguliwa" required value="<%= formData.siku_kufunguliwa || '' %>" class="<%= missingFields.includes('siku_kufunguliwa') ? 'input-invalid' : '' %>" placeholder="Mfano: Jumatatu - Jumamosi, 8:00 - 18:00">
        </div>
        <div class="field-row">
          <div class="field">
            <label>Picha ya Duka / Nembo *</label>
            <input type="file" name="picha_duka" accept="image/*" required class="<%= missingFields.includes('picha_duka') ? 'input-invalid' : '' %>">
          </div>
          <div class="field">
            <label>Nakala ya Kitambulisho *</label>
            <input type="file" name="kitambulisho" accept="image/*,application/pdf" required class="<%= missingFields.includes('kitambulisho') ? 'input-invalid' : '' %>">
          </div>
        </div>
        <div class="field">
          <label>Password *</label>
          <div class="password-control"><input type="password" name="password" required minlength="6" autocomplete="new-password" class="<%= missingFields.includes('password') ? 'input-invalid' : '' %>"><button type="button" class="btn btn-ghost btn-sm" data-password-toggle aria-label="Onyesha password">Onyesha</button></div>
          <div class="hint">Angalau herufi/tarakimu 6.</div>
        </div>
        <p class="hint" style="margin-bottom:14px;">Taarifa zote zilizowekwa alama ya * ni za lazima — hii ni kwa ajili ya usalama wa jukwaa na wanunuzi wako.</p>
        <button type="submit" class="btn btn-accent btn-block">Tuma Ombi la Usajili</button>
      </form>
    </div>
    <p class="center-note">Tayari una akaunti? <a href="/ingia?aina=muuzaji">Ingia hapa</a></p>
    <p class="center-note">Unataka kusafirisha bidhaa? <a href="/jisajili/mwasafirishaji">Jisajili kama mwasafirishaji</a></p>
  </div>
</div>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="/public/js/map.js"></script>
<script>sokoInitMapPicker('rampaDuka', 'latitude', 'longitude');</script>
<script src="/public/js/forms.js"></script>
</body>
</html>
