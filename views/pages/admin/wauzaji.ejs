<%- include('../../partials/dash-top-admin') %>

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; flex-wrap:wrap; gap:10px;">
  <h1 style="margin:0;">Wauzaji (Maduka)</h1>
  <div class="radio-group">
    <a href="/admin/wauzaji?status=pending" class="btn btn-sm <%= filter==='pending' ? 'btn-accent':'btn-outline' %>">Zinazosubiri</a>
    <a href="/admin/wauzaji?status=approved" class="btn btn-sm <%= filter==='approved' ? 'btn-accent':'btn-outline' %>">Zilizoidhinishwa</a>
    <a href="/admin/wauzaji?status=suspended" class="btn btn-sm <%= filter==='suspended' ? 'btn-accent':'btn-outline' %>">Zilizosimamishwa</a>
    <a href="/admin/wauzaji?status=all" class="btn btn-sm <%= filter==='all' ? 'btn-accent':'btn-outline' %>">Zote</a>
  </div>
</div>

<% if (!wauzaji.length) { %>
  <div class="empty"><div class="mark">&#127978;</div>Hakuna maduka kwenye kundi hili.</div>
<% } else { %>
<div class="table-wrap">
  <table>
    <thead><tr><th>Duka</th><th>Aina ya Bidhaa</th><th>Simu</th><th>KYC</th><th>Kiwango</th><th>Hali</th><th>Vitendo</th></tr></thead>
    <tbody>
      <% wauzaji.forEach(s => { %>
      <tr>
        <td class="strong"><%= s.jina_duka %><br><span style="font-size:12px; color:var(--text-faint); font-weight:400;"><%= s.location || '' %></span></td>
        <td><%= s.aina_bidhaa %></td>
        <td><%= s.simu %></td>
        <td><span class="badge badge-<%= s.kyc_status === 'verified' ? 'approved' : 'pending' %>"><%= s.kyc_status || 'pending' %></span></td>
        <td><span class="badge badge-<%= s.tier.toLowerCase() %>"><%= s.tier %></span></td>
        <td><span class="badge badge-<%= s.status %>"><%= s.status %></span></td>
        <td class="row-actions">
          <% if (s.kitambulisho) { %><a href="/portal-siri/nyaraka/seller/<%= s.id %>/kitambulisho" target="_blank" class="btn btn-ghost btn-sm" rel="noopener">Kitambulisho</a><% } %>
          <% if (isOwner && s.kyc_status !== 'verified') { %>
            <form action="/admin/wauzaji/<%= s.id %>/kyc" method="POST"><input type="hidden" name="status" value="verified"><button class="btn btn-accent btn-sm">Thibitisha KYC</button></form>
            <form action="/admin/wauzaji/<%= s.id %>/kyc" method="POST" onsubmit="return confirm('Kataa KYC ya muuzaji huyu?')"><input type="hidden" name="status" value="rejected"><button class="btn btn-danger btn-sm">Kataa KYC</button></form>
          <% } %>
          <% if (s.status === 'pending') { %>
            <form action="/admin/wauzaji/<%= s.id %>/idhinisha" method="POST"><button class="btn btn-accent btn-sm">Idhinisha</button></form>
            <form action="/admin/wauzaji/<%= s.id %>/kataa" method="POST"><button class="btn btn-danger btn-sm">Kataa</button></form>
          <% } else if (s.status === 'approved') { %>
            <form action="/admin/wauzaji/<%= s.id %>/simamisha" method="POST"><button class="btn btn-outline btn-sm">Simamisha</button></form>
          <% } else if (s.status === 'suspended' || s.status === 'rejected') { %>
            <form action="/admin/wauzaji/<%= s.id %>/rejesha" method="POST"><button class="btn btn-accent btn-sm">Rejesha</button></form>
          <% } %>
          <form action="/admin/wauzaji/<%= s.id %>/futa" method="POST" onsubmit="return confirm('Una uhakika unataka kufuta duka hili kabisa?')"><button class="btn btn-danger btn-sm">Futa</button></form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<%- include('../../partials/dash-bottom') %>
