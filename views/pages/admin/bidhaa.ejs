<%- include('../../partials/dash-top-admin') %>

<h1>Bidhaa Zote</h1>
<p style="margin-bottom:24px;">Ondoa bidhaa zisizofaa au zinazokiuka sheria za jukwaa.</p>

<% if (!bidhaa.length) { %>
  <div class="empty"><div class="mark">&#128230;</div>Bado hakuna bidhaa kwenye jukwaa.</div>
<% } else { %>
<div class="table-wrap">
  <table>
    <thead><tr><th>Bidhaa</th><th>Duka</th><th>Bei</th><th>Hali</th><th>Vitendo</th></tr></thead>
    <tbody>
      <% bidhaa.forEach(p => { %>
      <tr>
        <td class="strong"><%= p.jina %></td>
        <td><%= p.jina_duka %></td>
        <td><%= fmtMoney(p.bei) %></td>
        <td><span class="badge <%= p.hali === 'ipo' ? 'badge-approved' : 'badge-rejected' %>"><%= p.hali %></span></td>
        <td class="row-actions">
          <a href="/bidhaa/<%= p.id %>" target="_blank" class="btn btn-ghost btn-sm">Ona</a>
          <form action="/admin/bidhaa/<%= p.id %>/futa" method="POST" onsubmit="return confirm('Ondoa bidhaa hii kwenye jukwaa?')"><button class="btn btn-danger btn-sm">Futa</button></form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<%- include('../../partials/dash-bottom') %>
