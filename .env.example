# Nakili faili hii kuwa ".env" kisha badilisha thamani hizi

# Bandari (port) ambayo tovuti itaendesha (hosting nyingi huweka PORT yenyewe)
PORT=3000

# Siri ya session — badilisha kuwa maneno marefu ya nasibu kabla ya kwenda LIVE
SESSION_SECRET=badilisha-hii-kuwa-siri-ndefu-na-ngumu

# Akaunti ya kwanza ya ADMIN — inatengenezwa mara ya kwanza tu unapoanzisha mfumo
ADMIN_EMAIL=admin@sokolamtandao.co.tz
ADMIN_PASSWORD=BadilishaHiiPassword123

# Code ya pili kwa kuingia Admin/Staff. Weka code ndefu ya siri na usiishiriki.
ADMIN_2FA_CODE=badilisha-code-ya-2fa

# YouTube video IDs za mwongozo (video 4 za mnunuzi, muuzaji, dereva na admin)
SOKO_TUTORIAL_BUYER=
SOKO_TUTORIAL_SELLER=
SOKO_TUTORIAL_DRIVER=
SOKO_TUTORIAL_ADMIN=

# Render: weka hizi kwenye Environment baada ya kuunda Persistent Disk.
# SOKO_DATA_DIR=/var/data
# SOKO_UPLOAD_DIR=/var/data/uploads
